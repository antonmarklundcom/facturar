# ---------------------------------------------------------------------------
# facturar — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# `tsx` does not auto-load `.env`; pass it explicitly when running scripts:
#   npx tsx --env-file=.env scripts/<file>.ts
# ---------------------------------------------------------------------------

# MySQL connection string for Drizzle + the runtime pool.
# Hostinger: hPanel -> Databases -> Management. For local dev use your own MySQL.
# Remote access from outside Hostinger requires the client IP to be whitelisted
# under hPanel -> Databases -> Remote MySQL.
# Format: mysql://<user>:<password>@<host>:3306/<database>
DATABASE_URL="mysql://user:password@localhost:3306/facturar"

# Secret used to encrypt the iron-session cookie (PR-3).
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Public base URL of the deployment, used to build buyer document links
# (`/d/<token>`) for WhatsApp and email. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The WhatsApp number the public landing page's CTA writes to (PR-15).
# Normalised international form, e.g. +595981123456. Leave empty and the
# landing page simply shows the "log in" button instead of the WhatsApp one.
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# Resend API key for outbound email (PR-12). Leave empty to disable sending.
# https://resend.com -> API Keys
RESEND_API_KEY=""

# Verified "from" address on the Resend sender domain (PR-12).
RESEND_FROM="facturar <no-reply@facturar.clientes.com.py>"

# The demo seed (decision 16) reads these too:
#   npm run db:seed          — creates the demo tenant if it is not there
#   npm run db:seed -- --reset  — wipes that tenant and rebuilds it
#
# Where issued PDFs are frozen (guardrail 4). Must be writable and OUTSIDE the
# app directory, so a deploy never overwrites it. Relative paths resolve from
# the app root; on Hostinger use an absolute path on the slot's persistent disk.
DOCUMENT_STORAGE_DIR="storage/documents"

# Optional: a scratch MySQL database for the database-backed tests (the
# gap-free numbering test). Those tests are skipped when this is unset.
# The database must have the migrations applied.
TEST_DATABASE_URL=""

# How many reverse proxies append to `x-forwarded-for` before the app sees it
# (PR-16 login limiter). The header is a list each proxy appends to, so only
# the entries your own proxies added can be trusted — the app counts from the
# right. `1` suits a single managed front end, which is what a Hostinger Node
# slot is; VERIFY IT AT DEPLOY TIME by logging the raw header once from the
# live URL. `0` means "no proxy, do not believe this header", and the limiter's
# per-IP scope is then simply not applied. Defaults to 1 when unset.
TRUSTED_PROXY_HOPS="1"

# Set to "1" to allow `npm run db:seed` to run when NODE_ENV=production. The
# demo tenant's password is a constant in scripts/seed.ts and its accounts are
# ordinary admins, so seeding a real deployment publishes working credentials.
ALLOW_DEMO_SEED=""
